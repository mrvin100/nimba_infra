# Copy to .env and adjust for your environment. The real .env is never committed.
#
#   cp .env.example .env
#
# This file drives the FULL containerized stack (infra/docker-compose.yml): web,
# app, postgres, minio, mailpit — all part of the default stack, including on a
# deployed server (see the Mail section below). Variable names deliberately
# match app/.env.example and web/.env.example so nothing drifts between the native
# dev setup and this one. Defaults are safe for a first local run; change the
# secrets and public URLs before pointing this at a real environment.

#----------------
# Ports exposed on the HOST
#----------------
APP_PORT=8080
WEB_PORT=3000
POSTGRES_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

#----------------
# postgres service
#----------------
POSTGRES_DB=nimba
POSTGRES_USER=nimba
POSTGRES_PASSWORD=change-me

# Managed Postgres instead of the local container (Neon, RDS, the bank's on-prem
# server, etc.): set the WHOLE JDBC connection string here and it is used verbatim
# — do NOT also try to redirect POSTGRES_HOST/PORT to it. Keep sslmode=require for
# JDBC. Credentials still come from POSTGRES_USER/POSTGRES_PASSWORD above. Leave
# unset to use the local `postgres` container.
# DATABASE_URL=jdbc:postgresql://ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX_SIZE=10

#----------------
# app service (backend)
#----------------

# Prefix applied to every REST endpoint. The frontend build reads the same value
# (NEXT_PUBLIC_API_BASE_PATH is derived from it, see docker-compose.yml).
API_BASE_PATH=/api/v1

# Amortization-schedule CSV upload (NIMBA-19)
CSV_UPLOAD_MAX_FILE_SIZE=2MB

# Session cookie (NIMBA-9). MUST be true once the stack is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=PT8H

# Login throttling (NIMBA-9B)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_WINDOW=PT15M

# Actuator endpoints exposed over HTTP. Keep this minimal in production.
ACTUATOR_EXPOSED_ENDPOINTS=health,info

# Public origin where `web` is actually reachable by a human clicking an
# invitation/set-password link in their inbox — e.g. https://nimba.your-bank.tld
# in production. Set this to the URL people actually type; leaving it at the
# default only breaks those e-mailed links, not the app itself.
APP_FRONTEND_BASE_URL=http://localhost:3000
# Genuinely cross-origin browsers only. In this stack the browser calls `web`,
# which proxies /api/* to `app` server-side, so those calls are same-origin and
# never consult this list — `app` recognizes them as such through the
# X-Forwarded-* headers the proxy sets (server.forward-headers-strategy). Add an
# entry only when some other site's JavaScript must call this API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000
INVITATION_TTL=P7D

#----------------
# Mail (invitations)
#----------------
MAIL_ENABLED=true
# `smtp` (Mailpit — part of the default stack, including a deployed server; the
# admin reads sent mail from its web UI at MAILPIT_UI_PORT instead of a real
# mailbox) or `resend` (HTTPS API; SMTP is commonly blocked outbound on hosted
# platforms). Switch to `resend` once the bank wants real delivery to external
# mailboxes — Mailpit can keep running alongside it or be dropped from the
# stack.
MAIL_TRANSPORT=smtp
MAIL_HOST=mailpit
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@nimba.local
MAIL_FROM_NAME=Nimba
# Resend (used when MAIL_TRANSPORT=resend). Never commit the real key.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# Mailpit's web UI holds every sent e-mail in clear text, including
# password-reset and invitation links — set this (space-separated
# "user:pass" pairs for more than one account) before exposing MAILPIT_UI_PORT
# on a real server. Leave empty for local dev (UI open, no login).
MAILPIT_UI_AUTH=

#----------------
# minio service (object storage: avatars, organisation logo)
#----------------
# Container root user — local container only.
MINIO_ROOT_USER=nimba
MINIO_ROOT_PASSWORD=change-me-too
# App-level credentials — locally these match the root user above; in production
# point MINIO_ENDPOINT (docker-compose.yml) at a hosted S3-compatible service and
# set these to that service's access key / secret key instead.
MINIO_ACCESS_KEY=nimba
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=nimba

#----------------
# web service (frontend)
#----------------
# Only needed if the deployment target sleeps when idle (e.g. an .onrender.com
# origin) — shows a "waking the service" notice on login. Leave empty for an
# always-on / on-premise deployment.
NEXT_PUBLIC_API_URL=
